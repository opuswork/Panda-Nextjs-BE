{
  "name": "panda-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000 --webpack",
    "postinstall": "prisma generate",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "cd server && npx prisma generate && cd ..",
    "prisma:studio": "cd server && npx prisma studio",
    "prisma:migrate": "cd server && npx prisma migrate dev",
    "prisma:migrate:deploy": "cd server && npx prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^6.19.1",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "next": "16.0.10",
    "prisma": "^6.19.1",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.0.10"
  }
}
